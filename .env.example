# Turquaz Resurrected — yerel ortam değişkenleri örneği.
# Bu dosyayı .env olarak kopyalayın ve değerleri kendinize göre güncelleyin.
#
# Windows PowerShell:    Copy-Item .env.example .env
# Windows CMD:           copy .env.example .env
# Linux/Mac:             cp .env.example .env

# JWT için HMAC-SHA256 paylaşılan sırrı (en az 32 byte).
# Yeni bir tane üretmek için (Linux/Mac):
#   openssl rand -base64 48
# Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | %{ Get-Random -Maximum 256 }))
TURQUAZ_JWT_SECRET=dev-only-secret-please-change-me-32+bytes-required

# Token ömrü (ISO-8601 süresi). Örn: PT1H = 1 saat, P1D = 1 gün.
TURQUAZ_JWT_TTL=PT8H
